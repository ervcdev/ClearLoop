-- Obligation.daml
-- Spec DAML para ClearLoop.
-- No desplegado — documenta el enfoque alternativo con Canton.
-- Comparativa en ARCHITECTURE.md.

module ClearLoop.Obligation where

template Obligation
  with
      creditor : Party
      debtor : Party
      amount : Decimal
      commitment : Text
      active : Bool
    where
      signatory creditor, debtor

      choice Settle : ()
        controller creditor, debtor
          do
            assert this.active
            create this with active = False

      choice Transfer : ContractId Obligation
          newDebtor : Party
        controller creditor
          do
            assert this.active
            create this with debtor = newDebtor

template NettingProposal
  with
      proposer : Party
      obligationIds : [ContractId Obligation]
      deltas : [Int]
      deadline : Time
      signatories : [Party]
    where
      signatory proposer

      choice Sign : ()
        controller signatory signatories
          do
            assert (time < deadline)
            return ()

      choice Execute : ()
        controller proposer
          do
            assert (time < deadline)
            -- Verificar que todos firmaron
            -- Archivar obligaciones originales
            -- Crear nuevas obligaciones neteadas
            return ()

template AuditEntry
  with
      cycleHash : Text
      timestamp : Time
      description : Text
    where
      signatory (proposer : Party)
      observer (observer : Party)
